# 이 파일을 .env 로 복사하고 실제 값을 채워넣어줘 (cp .env.example .env).
# 여기서 쓰인 API 키는 전부 백엔드에서만 쓰이고 프론트엔드로는 절대 전달되지 않아.

# 어떤 LLM 제공자를 쓸지 (groq | gemini). 아래 두 제공자 설정 중 선택한 쪽의 키만 채우면 돼.
LLM_PROVIDER=gemini

# --- Gemini (LLM_PROVIDER=gemini일 때 사용) ---
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=여기에-발급받은-키를-붙여넣기
# 항상 최신 Flash 모델을 가리키는 별칭이라 모델이 바뀌어도 안전함
GEMINI_MODEL=gemini-flash-latest
# 주 모델이 무료 한도(429)에 걸리면 자동으로 넘어갈 예비 모델 (선택)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Groq (LLM_PROVIDER=groq일 때 사용) ---
# https://console.groq.com/keys 에서 발급
GROQ_API_KEY=여기에-발급받은-키를-붙여넣기
GROQ_MODEL=llama-3.3-70b-versatile

# 검수용 2차 LLM 호출을 건너뛸지 (true면 응답이 빠르고 API 호출이 절반). 기본 true.
# 말투를 한 번 더 다듬고 싶으면 false 로 바꿔.
FAST_MODE=true

# --- 저장소 (선택) ---
# 비워두면 일기가 backend/data/diary-data.json 파일에 저장돼 (로컬 개발에 충분함).
# PostgreSQL 연결 문자열(예: Supabase)을 넣으면 그 DB에 저장돼 재시작에도 보존됨.
# DATABASE_URL=postgresql://...

# 서버 포트 (선택, 기본값 4000)
PORT=4000
