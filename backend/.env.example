# 이 파일을 .env 로 복사하고 실제 값을 채워넣어줘.
# 여기서 쓰인 API 키는 전부 백엔드에서만 쓰이고 프론트엔드로는 절대 전달되지 않아.

# 어떤 LLM 제공자를 쓸지 (groq | gemini). 아래 두 제공자 설정 중 선택한 쪽의 키만 채우면 돼.
LLM_PROVIDER=groq

# --- Groq (LLM_PROVIDER=groq일 때 사용) ---
GROQ_API_KEY=여기에-발급받은-키를-붙여넣기
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (LLM_PROVIDER=gemini일 때 사용) ---
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=여기에-발급받은-키를-붙여넣기
GEMINI_MODEL=gemini-2.5-flash

# 서버 포트 (선택, 기본값 4000)
PORT=4000
