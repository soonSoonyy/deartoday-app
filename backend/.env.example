# 이 파일을 .env 로 복사하고 실제 값을 채워넣어줘 (cp .env.example .env).
# 여기서 쓰인 API 키·비밀은 전부 백엔드에서만 쓰이고 프론트엔드로는 절대 전달되지 않아.

# 어떤 LLM 제공자를 쓸지 (groq | gemini). 선택한 쪽의 키만 채우면 돼.
LLM_PROVIDER=gemini

# --- Gemini (LLM_PROVIDER=gemini일 때 사용) ---
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=여기에-발급받은-키를-붙여넣기
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Groq (LLM_PROVIDER=groq일 때 사용) ---
# https://console.groq.com/keys 에서 발급
GROQ_API_KEY=여기에-발급받은-키를-붙여넣기
GROQ_MODEL=llama-3.3-70b-versatile

# 검수용 2차 LLM 호출을 건너뛸지 (true면 빠르고 API 호출 절반). 기본 true.
FAST_MODE=true

# --- 저장소 (선택) ---
# 비워두면 backend/data/diary-data.json 파일에 저장(로컬 개발에 충분).
# PostgreSQL 연결 문자열(예: Supabase)을 넣으면 그 DB에 저장돼 재시작에도 보존됨.
# DATABASE_URL=postgresql://...

# --- 로그인/인증 ---
# JWT 서명 키(필수). 아무도 모를 긴 임의 문자열로 바꿔줘. 예) openssl rand -hex 32
JWT_SECRET=여기에-길고-임의의-비밀문자열

# OAuth 콜백에 쓰이는 앱의 공개 주소. 로컬은 http://localhost:4000,
# 배포는 https://<렌더주소>.onrender.com 로 설정.
APP_BASE_URL=http://localhost:4000

# 구글 로그인 (https://console.cloud.google.com → OAuth 2.0 클라이언트). 안 넣으면 구글 버튼 비활성.
# 승인된 리디렉션 URI: <APP_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 로그인 (https://developers.kakao.com → 내 애플리케이션 → REST API 키). 안 넣으면 카카오 버튼 비활성.
# Redirect URI: <APP_BASE_URL>/api/auth/kakao/callback
KAKAO_REST_API_KEY=
# (선택) 카카오 보안 강화용 Client Secret
KAKAO_CLIENT_SECRET=

# 서버 포트 (선택, 기본값 4000)
PORT=4000
